{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "benchmark-task/T6/1",
 "title": "evoparam benchmark task T6 (ERP scoring), version 1",
 "description": "Task input (a JSON descriptor next to an .npz file of arrays) and task output. One row per channel, condition and measure of the definitions: the value (s for latencies, data units otherwise) and its standardised measurement error (sme, same unit; null when the method gives none).",
 "x-task": "T6",
 "x-name": "ERP scoring",
 "x-output-format": "tsv",
 "$defs": {
  "number_or_null": {
   "type": [
    "number",
    "null"
   ]
  },
  "probability": {
   "type": [
    "number",
    "null"
   ],
   "minimum": 0,
   "maximum": 1
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "window": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "array": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "shape",
    "sha256"
   ],
   "properties": {
    "shape": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1
     },
     "minItems": 1,
     "maxItems": 4
    },
    "sha256": {
     "$ref": "#/$defs/sha256"
    }
   }
  },
  "channel": {
   "type": "string",
   "minLength": 1
  },
  "input": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schema",
    "role",
    "task",
    "suite",
    "cell",
    "split",
    "data_file",
    "arrays",
    "sfreq",
    "tmin",
    "units",
    "ch_names",
    "n_trials",
    "definitions"
   ],
   "properties": {
    "schema": {
     "const": "benchmark-task/T6/1"
    },
    "role": {
     "const": "input"
    },
    "task": {
     "const": "T6"
    },
    "suite": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "name",
      "version"
     ],
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1
      },
      "version": {
       "type": "string",
       "pattern": "^\\d+\\.\\d+\\.\\d+$"
      }
     }
    },
    "cell": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "split": {
     "enum": [
      "public",
      "hidden",
      "real"
     ]
    },
    "data_file": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_.-]+\\.npz$"
    },
    "arrays": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "data",
      "average"
     ],
     "properties": {
      "data": {
       "$ref": "#/$defs/array"
      },
      "average": {
       "$ref": "#/$defs/array"
      }
     }
    },
    "sfreq": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "tmin": {
     "type": "number"
    },
    "units": {
     "type": "string",
     "minLength": 1
    },
    "ch_names": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/channel"
     },
     "minItems": 1,
     "uniqueItems": true
    },
    "modality": {
     "type": "string"
    },
    "site": {
     "type": "string"
    },
    "stim_channels": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/channel"
     }
    },
    "n_trials": {
     "type": "integer",
     "minimum": 1
    },
    "hints": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "window": {
       "$ref": "#/$defs/window"
      },
      "baseline": {
       "$ref": "#/$defs/window"
      },
      "preset": {
       "type": "string"
      }
     }
    },
    "source": {
     "type": "object"
    },
    "definitions": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "condition",
       "channel",
       "window",
       "polarity",
       "measures",
       "source"
      ],
      "properties": {
       "condition": {
        "type": "string",
        "minLength": 1
       },
       "channel": {
        "$ref": "#/$defs/channel"
       },
       "window": {
        "$ref": "#/$defs/window"
       },
       "polarity": {
        "enum": [
         "negative",
         "positive"
        ]
       },
       "measures": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
         "enum": [
          "mean_amplitude",
          "peak_amplitude",
          "peak_latency",
          "fractional_area_latency"
         ]
        }
       },
       "source": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "output_row": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "channel",
    "condition",
    "measure",
    "value",
    "sme"
   ],
   "properties": {
    "channel": {
     "$ref": "#/$defs/channel"
    },
    "condition": {
     "type": "string",
     "minLength": 1
    },
    "measure": {
     "enum": [
      "mean_amplitude",
      "peak_amplitude",
      "peak_latency",
      "fractional_area_latency"
     ]
    },
    "value": {
     "$ref": "#/$defs/number_or_null"
    },
    "sme": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0
    }
   }
  },
  "output": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/output_row"
   }
  }
 },
 "x-columns": {
  "required": [
   "channel",
   "condition",
   "measure",
   "value",
   "sme"
  ],
  "optional": []
 }
}
