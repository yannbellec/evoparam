{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "benchmark-task/T7/1",
 "title": "evoparam benchmark task T7 (time-frequency response), version 1",
 "description": "Task input (a JSON descriptor next to an .npz file of arrays) and task output. One row per time-frequency zone the method finds on a channel (numbered from 0): its sign (+1 power increase, -1 decrease), frequency centroid (Hz) and time centroid (s); optional bounds and p-value. A channel without row has no zone.",
 "x-task": "T7",
 "x-name": "time-frequency response",
 "x-output-format": "tsv",
 "$defs": {
  "number_or_null": {
   "type": [
    "number",
    "null"
   ]
  },
  "probability": {
   "type": [
    "number",
    "null"
   ],
   "minimum": 0,
   "maximum": 1
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "window": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "array": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "shape",
    "sha256"
   ],
   "properties": {
    "shape": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1
     },
     "minItems": 1,
     "maxItems": 4
    },
    "sha256": {
     "$ref": "#/$defs/sha256"
    }
   }
  },
  "channel": {
   "type": "string",
   "minLength": 1
  },
  "input": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schema",
    "role",
    "task",
    "suite",
    "cell",
    "split",
    "data_file",
    "arrays",
    "sfreq",
    "tmin",
    "units",
    "ch_names",
    "n_trials"
   ],
   "properties": {
    "schema": {
     "const": "benchmark-task/T7/1"
    },
    "role": {
     "const": "input"
    },
    "task": {
     "const": "T7"
    },
    "suite": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "name",
      "version"
     ],
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1
      },
      "version": {
       "type": "string",
       "pattern": "^\\d+\\.\\d+\\.\\d+$"
      }
     }
    },
    "cell": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "split": {
     "enum": [
      "public",
      "hidden",
      "real"
     ]
    },
    "data_file": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_.-]+\\.npz$"
    },
    "arrays": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "data"
     ],
     "properties": {
      "data": {
       "$ref": "#/$defs/array"
      }
     }
    },
    "sfreq": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "tmin": {
     "type": "number"
    },
    "units": {
     "type": "string",
     "minLength": 1
    },
    "ch_names": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/channel"
     },
     "minItems": 1,
     "uniqueItems": true
    },
    "modality": {
     "type": "string"
    },
    "site": {
     "type": "string"
    },
    "stim_channels": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/channel"
     }
    },
    "n_trials": {
     "type": "integer",
     "minimum": 1
    },
    "hints": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "window": {
       "$ref": "#/$defs/window"
      },
      "baseline": {
       "$ref": "#/$defs/window"
      },
      "preset": {
       "type": "string"
      }
     }
    },
    "source": {
     "type": "object"
    }
   }
  },
  "output_row": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "channel",
    "zone",
    "sign",
    "freq_centroid",
    "time_centroid"
   ],
   "properties": {
    "channel": {
     "$ref": "#/$defs/channel"
    },
    "zone": {
     "type": "integer",
     "minimum": 0
    },
    "sign": {
     "enum": [
      -1,
      1
     ]
    },
    "freq_centroid": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "time_centroid": {
     "type": "number"
    },
    "f_low": {
     "type": [
      "number",
      "null"
     ],
     "exclusiveMinimum": 0
    },
    "f_high": {
     "type": [
      "number",
      "null"
     ],
     "exclusiveMinimum": 0
    },
    "t_start": {
     "$ref": "#/$defs/number_or_null"
    },
    "t_end": {
     "$ref": "#/$defs/number_or_null"
    },
    "p_value": {
     "$ref": "#/$defs/probability"
    }
   }
  },
  "output": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/output_row"
   }
  }
 },
 "x-columns": {
  "required": [
   "channel",
   "zone",
   "sign",
   "freq_centroid",
   "time_centroid"
  ],
  "optional": [
   "f_low",
   "f_high",
   "t_start",
   "t_end",
   "p_value"
  ]
 }
}
